      "flood_evi_max": 0.3,
      "peak_min": 0.4,
      "amp_min": 0.25,
      "min_evi_max": 0.2,
      "trend_eps": 0.02
    },
    "resolution": "1 km / monthly composite",
    "period": "2026-06-01 to 2026-06-30",
    "month": "2026-06",
